{
  "productName": "OmniMD",
  "identifier": "com.omnid.app",
  "version": "0.1.0",
  "build": {
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "OmniMD - Anything to Markdown",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "shadow": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "resources": {
      "bundle_extras/python": "python"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": ["icons/icon.ico"]
  }
}
